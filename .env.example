# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: kun server-side. ALDRIG i frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Public bucket som Meta kan hente billeder fra
SUPABASE_STORAGE_BUCKET=kampagne-assets

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Meta ----
# Graph API version
META_GRAPH_VERSION=v21.0
# Sæt til "true" indtil du har testet. Så logges opslag i stedet for at blive publiceret.
PUBLISH_DRY_RUN=true

# ---- Sikkerhed ----
# 32-byte nøgle (base64) til kryptering af kundernes Meta-tokens i databasen.
# Generér med: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Beskytter den planlagte publiceringsfunktion mod at blive kaldt udefra.
CRON_SECRET=
