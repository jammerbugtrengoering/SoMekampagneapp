# ---- Klient (bundles ind i browseren — kun offentlige værdier) ----
VITE_SUPABASE_URL=https://phloauxphbyewwjnaxcv.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---- Netlify-funktioner (server-side — må ALDRIG have VITE_-præfiks) ----
# VITE_-variabler bundles ind i klient-JS. Alt herunder skal derfor stå uden.
SUPABASE_URL=https://phloauxphbyewwjnaxcv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

META_GRAPH_VERSION=v21.0

# Sæt til "false" når du er klar til at publicere for alvor.
PUBLISH_DRY_RUN=true

# 32 byte base64 — krypterer kundernes Meta-tokens i databasen.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Beskytter den planlagte publicering mod kald udefra.
#   openssl rand -hex 32
CRON_SECRET=
