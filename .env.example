# =====================================================================
# Nøgler hentes i Supabase: Settings → API Keys
#
# Supabase udfaser anon og service_role ved udgangen af 2026. Brug de nye:
#   sb_publishable_…  afløser anon        (offentlig, må gerne i browseren)
#   sb_secret_…       afløser service_role (bypasser RLS — kun på serveren)
# De gamle navne læses stadig som fallback.
# =====================================================================

# ---------------------------------------------------------------------
# PÅKRÆVET — uden disse fire starter appen ikke
# ---------------------------------------------------------------------

# Klienten. VITE_ betyder at værdien bages ind i browseren, så kun offentligt.
VITE_SUPABASE_URL=https://phloauxphbyewwjnaxcv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Serveren. Netlify-funktionerne bypasser RLS for at kunne dekryptere
# Meta-tokens og køre den planlagte publicering uden en bruger-session.
# ALDRIG med VITE_-præfiks — så ville den ligge i klient-JS'en.
SUPABASE_SECRET_KEY=sb_secret_

# Kampagnegenereringen. Kaldes kun fra en funktion, aldrig fra browseren.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# PÅKRÆVET når du gemmer det første Meta-token
# ---------------------------------------------------------------------

# 32 byte base64. Skift den ALDRIG efter at tokens er gemt — så kan de
# ikke dekrypteres igen, og alle kanaler skal sættes op forfra.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# VALGFRIT — har fornuftige standardværdier
# ---------------------------------------------------------------------

# AI-baggrunde. Uden den virker upload og skabeloner stadig; AI-fanen siger
# bare at den ikke er slaaet til. Koster 0,30-1 kr per billede.
#   aistudio.google.com/apikey
# GEMINI_API_KEY=

# Google omdoeber billedmodellerne jaevnligt. Standard: gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=

# Storage-bucket til billeder. Standard: kampagne-assets
# VITE_SUPABASE_BUCKET=

# Standard er "true" (intet publiceres). Sæt til "false" når du er klar.
# PUBLISH_DRY_RUN=true

# Kun hvis du vil kunne kalde den planlagte publicering manuelt over HTTP.
# Uden den slipper kun Netlifys scheduler ind — hvilket er det sikre valg.
#   openssl rand -hex 32
# CRON_SECRET=

# Graph API-version. Standard v21.0.
# META_GRAPH_VERSION=v21.0

# Modellen der skriver opslagene. Standard claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Funktionerne bruger VITE_SUPABASE_URL hvis denne ikke er sat.
# SUPABASE_URL=

# ---------------------------------------------------------------------
# Gamle nøglenavne — kun hvis du ikke er skiftet endnu
# ---------------------------------------------------------------------
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
