# =====================================================================
# Nøgler hentes i Supabase: Settings → API Keys
#
# Supabase udfaser anon og service_role ved udgangen af 2026. Brug de nye:
#   sb_publishable_…  afløser anon        (offentlig, må gerne i browseren)
#   sb_secret_…       afløser service_role (bypasser RLS — kun på serveren)
# De gamle navne læses stadig som fallback.
# =====================================================================

# ---------------------------------------------------------------------
# PÅKRÆVET — uden disse fire starter appen ikke
# ---------------------------------------------------------------------

# Klienten. VITE_ betyder at værdien bages ind i browseren, så kun offentligt.
VITE_SUPABASE_URL=https://phloauxphbyewwjnaxcv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_

# Serveren. Netlify-funktionerne bypasser RLS for at kunne dekryptere
# Meta-tokens og køre den planlagte publicering uden en bruger-session.
# ALDRIG med VITE_-præfiks — så ville den ligge i klient-JS'en.
SUPABASE_SECRET_KEY=sb_secret_

# Kampagnegenereringen. Kaldes kun fra en funktion, aldrig fra browseren.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------
# PÅKRÆVET når du gemmer det første Meta-token
# ---------------------------------------------------------------------

# 32 byte base64. Skift den ALDRIG efter at tokens er gemt — så kan de
# ikke dekrypteres igen, og alle kanaler skal sættes op forfra.
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# VALGFRIT — har fornuftige standardværdier
# ---------------------------------------------------------------------

# AI-baggrunde. Uden dem virker upload og skabeloner stadig; AI-fanen siger
# bare at den ikke er slaaet til.
#
# To udbydere. Cloudflare er gratis: 10.000 neuroner om dagen, og et billede
# koster ca. 19 — altsaa omkring 500 billeder i doegnet. Gemini laver paenere
# billeder, men har ingen gratis kvote til billedmodellerne overhovedet, og
# paa free tier bruger Google indholdet til at forbedre deres produkter.
#
# Staar begge sat, vinder Cloudflare. AI_BILLED_UDBYDER kan tvinge valget.

# Cloudflare Workers AI (gratis)
#   Begge dele hentes samme sted:
#   dash.cloudflare.com/?to=/:account/ai/workers-ai -> Use REST API
#   -> Create a Workers AI API Token. Tokenet skal have Workers AI Read OG Edit;
#   Read alene kan ikke koere en model.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Standard: @cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_MODEL=

# Oversaetter beskrivelsen til engelsk foer den gaar til FLUX, hvis
# tekstencoderen forstaar engelsk bedst. Samme gratis kvote; en oversaettelse
# koster under en tusindedel af hvad billedet koster.
# Standard: @cf/meta/llama-3.1-8b-instruct
# CLOUDFLARE_TEKST_MODEL=

# Gemini (betalt). 0,30-1 kr per billede.
#   aistudio.google.com/apikey
# GEMINI_API_KEY=

# Google omdoeber billedmodellerne jaevnligt. Standard: gemini-3.1-flash-image
# GEMINI_IMAGE_MODEL=

# cloudflare eller gemini. Tom = den der har noegler, Cloudflare foerst.
# AI_BILLED_UDBYDER=

# Storage-bucket til billeder. Standard: kampagne-assets
# VITE_SUPABASE_BUCKET=

# Lader "Koer i Claude" i appen kalde `claude -p` paa din egen maskine, saa du
# slipper for copy/paste. Virker KUN under `npm run dev:api`.
#
# Filen her naar aldrig Netlify (.env er gitignoreret), saa et deploy kan ikke
# starte processer uanset hvad. Vaerdien skal vaere praecis "true".
# TILLAD_LOKAL_CLAUDE=true

# Adgangstoken til Supabases management-API. Bruges KUN af scripts paa din
# egen maskine (db:setup, org:opret) -- aldrig af appen eller af Netlify.
# Staar den her, huskes den; ellers skal den exportes i hver ny terminal.
#   supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Standard er "true" (intet publiceres). Sæt til "false" når du er klar.
# PUBLISH_DRY_RUN=true

# Kun hvis du vil kunne kalde den planlagte publicering manuelt over HTTP.
# Uden den slipper kun Netlifys scheduler ind — hvilket er det sikre valg.
#   openssl rand -hex 32
# CRON_SECRET=

# Graph API-version. Standard v21.0.
# META_GRAPH_VERSION=v21.0

# ---------------------------------------------------------------------
# LinkedIn
# ---------------------------------------------------------------------
# Fra linkedin.com/developers -> din app -> Auth.
#
# Til opslag paa en PERSONLIG profil kraeves produktet «Share on LinkedIn»,
# som du selv tilfoejer under Products. Ingen app review. Firmasider er en
# anden sag: de kraever Community Management API med ansoegning.
#
# Ligger KUN i Netlify. Klient-hemmeligheden maa aldrig faa VITE_-praefiks.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Redirect-URL'en matches EKSAKT af LinkedIn og skal vaere https.
# Udledes af Netlifys egen URL hvis den ikke saettes. Saet den manuelt hvis
# du vil koere flowet mod et deploy preview, som har et andet domaene.
# LINKEDIN_REDIRECT_URI=https://dit-site.netlify.app/api/linkedin-oauth?trin=callback

# Standard: openid profile w_member_social -- nok til at skrive paa egen
# profil. Firmasider kraever w_organization_social og rw_organization_admin.
# LINKEDIN_SCOPES=

# LinkedIn udfaser API-versioner efter ca. et aar. Standard 202608.
# LINKEDIN_VERSION=

# Modellen der skriver opslagene. Standard claude-sonnet-4-6.
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Funktionerne bruger VITE_SUPABASE_URL hvis denne ikke er sat.
# SUPABASE_URL=

# ---------------------------------------------------------------------
# Gamle nøglenavne — kun hvis du ikke er skiftet endnu
# ---------------------------------------------------------------------
# VITE_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
